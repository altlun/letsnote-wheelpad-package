# Build from this directory after running ../../setup/build-package.sh.
pkgname=wheelpad
pkgver=0.2.0
pkgrel=3
pkgdesc="Circular scrolling for Let's Note touchpads on Wayland and Hyprland"
arch=('x86_64')
options=('!debug')
license=('MIT')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo')
source=("wheelpad-$pkgver.tar.gz")
sha256sums=('7443fd74ad54acaf93309cb80c582b71dfd4e7eed4c572c955ff79602029f004')

prepare() {
    cd "$srcdir/wheelpad-$pkgver"
    cargo fetch --locked
}
build() {
    cd "$srcdir/wheelpad-$pkgver"
    cargo build --release --frozen
}
check() {
    cd "$srcdir/wheelpad-$pkgver"
    cargo test --frozen
}
package() {
    cd "$srcdir/wheelpad-$pkgver"
    install -Dm755 target/release/wheelpad "$pkgdir/usr/bin/wheelpad"
    install -Dm644 setup/wheelpad.service "$pkgdir/usr/lib/systemd/user/wheelpad.service"
    install -Dm644 setup/70-wheelpad.rules "$pkgdir/usr/lib/udev/rules.d/70-wheelpad.rules"
    install -Dm644 setup/wheelpad.conf "$pkgdir/usr/lib/modules-load.d/wheelpad.conf"
    install -Dm644 setup/desktop/wheelpad.lua "$pkgdir/usr/share/wheelpad/wheelpad.lua"
    install -Dm644 README.md "$pkgdir/usr/share/doc/wheelpad/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/wheelpad/LICENSE"
}
